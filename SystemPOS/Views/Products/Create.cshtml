@model Product
@{
    ViewData["Title"] = "Nuevo producto";
    ViewData["Subtitle"] = "Agrega un producto al catálogo";
}

<div class="panel form-panel">
    <form asp-action="Create" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary full-column"></div>
        <div>
            <label asp-for="Name">Nombre</label>
            <input asp-for="Name" class="input" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Barcode">Código de barras</label>
            <input asp-for="Barcode" class="input" />
            <span asp-validation-for="Barcode" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Price">Precio de venta</label>
            <input asp-for="Price" class="input" type="number" step="0.01" />
            <span asp-validation-for="Price" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Stock">Existencia inicial</label>
            <input asp-for="Stock" class="input" type="number" step="0.001" />
            <span asp-validation-for="Stock" class="field-error"></span>
        </div>
        <div class="form-actions full-column">
            <a asp-action="Index" class="secondary-button">Cancelar</a>
            <button type="submit" class="primary-button">Guardar producto</button>
        </div>
    </form>
</div>
